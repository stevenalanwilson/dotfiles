# ── Navigation ────────────────────────────────────────────────────────────────
alias ..="cd .."
alias ...="cd ../.."
alias ~="cd ~"
alias proj="cd ~/Projects"

# ── Projects ──────────────────────────────────────────────────────────────────
alias p73="cd ~/Projects/73rdAllestreeWebApp"
alias psaw="cd ~/Projects/SAW"
alias pai="cd ~/Projects/AI-cost-explination"
alias pkit="cd ~/Projects/app-prototyping-kit"
alias pagent="cd ~/Projects/agentflow-flows"
alias pdots="cd ~/dotfiles"

# ── eza (better ls) ───────────────────────────────────────────────────────────
alias ls="eza --icons"
alias ll="eza -la --icons --git --group-directories-first"
alias lt="eza --tree --icons --level=2"
alias llt="eza --tree -la --icons --git --level=2"

# ── bat (better cat) ──────────────────────────────────────────────────────────
alias cat="bat --paging=never"
alias less="bat"

# ── Git ───────────────────────────────────────────────────────────────────────
alias gs="git status -sb"
alias ga="git add"
alias gc="git commit -m"
alias gca="git commit --amend --no-edit"
alias gp="git push"
alias gpf="git push --force-with-lease"
alias gl="git log --oneline --graph --decorate -20"
alias gd="git diff"
alias gds="git diff --staged"
alias gco="git checkout"
alias gcb="git checkout -b"
alias gpr="gh pr create --web"
alias gundo="git reset --soft HEAD~1"
alias gunstage="git reset HEAD --"

# ── Node / npm ────────────────────────────────────────────────────────────────
alias ni="npm install"
alias nr="npm run"
alias nrd="npm run dev"
alias nrb="npm run build"
alias nlg="npm list -g --depth=0"
alias pni="pnpm install"
alias pnr="pnpm run"
alias pnrd="pnpm run dev"
alias pnrb="pnpm run build"

# ── Python / uv ───────────────────────────────────────────────────────────────
alias py="python3"
alias venv="uv venv && source .venv/bin/activate"
alias ipy="ipython"

# ── Terraform ─────────────────────────────────────────────────────────────────
alias tf="terraform"
alias tfi="terraform init"
alias tfp="terraform plan"
alias tfa="terraform apply"
alias tfd="terraform destroy"
alias tfo="terraform output"

# ── Utilities ─────────────────────────────────────────────────────────────────
alias reload="source ~/.zshrc"
alias zshrc="$EDITOR ~/.zshrc"
alias aliases="$EDITOR ~/.zsh_aliases"
alias functions="$EDITOR ~/.zsh_functions"
alias dotfiles="cd ~/dotfiles && $EDITOR ."
alias ip="curl -s ifconfig.me"
alias localip="ipconfig getifaddr en0"
alias ports="lsof -i -P -n | grep LISTEN"
alias path='echo $PATH | tr ":" "\n"'
alias week="date +%V"
alias now="date '+%Y-%m-%d %H:%M:%S'"
alias cleanup="find . -name '.DS_Store' -delete && find . -name '*.log' -delete"

# ── fd + ripgrep ──────────────────────────────────────────────────────────────
alias find="fd"
alias grep="rg"

# ── macOS ─────────────────────────────────────────────────────────────────────
alias showfiles="defaults write com.apple.finder AppleShowAllFiles true && killall Finder"
alias hidefiles="defaults write com.apple.finder AppleShowAllFiles false && killall Finder"
alias flushdns="sudo dscacheutil -flushcache && sudo killall -HUP mDNSResponder && echo 'DNS flushed'"
alias screensaver="open -a ScreenSaverEngine"
