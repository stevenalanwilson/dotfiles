# ── Directory navigation ──────────────────────────────────────────────────────

# mkdir and cd in one step
mkcd() {
  mkdir -p "$1" && cd "$1"
}

# Clone a repo and immediately cd into it
gitclone() {
  git clone "$1" && cd "$(basename "$1" .git)"
}

# Kill whatever process is listening on a given port
port() {
  if [[ -z "$1" ]]; then
    echo "Usage: port <number>"
    return 1
  fi
  local pid
  pid=$(lsof -ti tcp:"$1")
  if [[ -z "$pid" ]]; then
    echo "Nothing listening on port $1"
  else
    echo "Killing PID $pid on port $1"
    kill -9 "$pid"
  fi
}

# Pretty-print JSON from a pipe or file
json() {
  if [[ -p /dev/stdin ]]; then
    python3 -m json.tool
  elif [[ -n "$1" ]]; then
    python3 -m json.tool "$1"
  else
    echo "Usage: json <file>  or  cat file.json | json"
  fi
}

# Show a quick summary of what changed in the last N commits (default 5)
recent() {
  local n="${1:-5}"
  git log --oneline --graph --decorate -"$n"
}

# Extract any archive format
extract() {
  if [[ -z "$1" ]]; then
    echo "Usage: extract <file>"
    return 1
  fi
  case "$1" in
    *.tar.bz2)  tar xjf "$1"   ;;
    *.tar.gz)   tar xzf "$1"   ;;
    *.tar.xz)   tar xJf "$1"   ;;
    *.tar)      tar xf  "$1"   ;;
    *.bz2)      bunzip2 "$1"   ;;
    *.gz)       gunzip  "$1"   ;;
    *.zip)      unzip   "$1"   ;;
    *.7z)       7z x    "$1"   ;;
    *)          echo "Don't know how to extract '$1'" ;;
  esac
}

# Search command history (fuzzy, if fzf available)
hist() {
  if command -v fzf &>/dev/null; then
    history 1 | fzf --tac --no-sort | awk '{$1=""; print $0}' | zsh
  else
    history 1 | grep "$1"
  fi
}

# Quick HTTP server in current dir
serve() {
  local port="${1:-8000}"
  echo "Serving on http://localhost:$port"
  python3 -m http.server "$port"
}

# Show directory size, sorted
dirsize() {
  du -sh "${1:-.}"/* 2>/dev/null | sort -rh | head -20
}

# Create a dated backup of a file
backup() {
  if [[ -z "$1" ]]; then
    echo "Usage: backup <file>"
    return 1
  fi
  cp "$1" "${1}.$(date +%Y%m%d_%H%M%S).bak"
  echo "Backed up to ${1}.$(date +%Y%m%d_%H%M%S).bak"
}

# ── AI — local Ollama ─────────────────────────────────────────────────────────
# Ask a question or pipe content to a local Ollama model.
# Nothing leaves your machine — safe for sensitive/client work.
# Output is rendered as formatted markdown via bat.
#
# Usage:
#   ask "what does this terraform block do"
#   cat main.tf | ask "explain this"
#   ask -m gemma3:4b "quick question"
#   ask --plain "question"   # raw output, no formatting (good for piping)
#   ask models               # list available models
#   ask -h                   # show help
#
# Default model: llama3.2
# Override:      ASK_MODEL env var or -m flag

ASK_MODEL="${ASK_MODEL:-llama3.2}"
ASK_HOST="${ASK_HOST:-http://localhost:11434}"

ask() {
  # ── help ──────────────────────────────────────────────────────────────────
  if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    cat <<'EOF'
ask — query a local Ollama model from the shell

Usage:
  ask "your question"
  cat file.txt | ask "summarise this"
  ask -m <model> "your question"
  ask --plain "your question"
  ask models

Options:
  -m <model>    use a specific model (default: llama3.2)
  --plain       raw output, no markdown formatting (useful for piping)
  models        list all locally available models
  -h / --help   show this help

Environment:
  ASK_MODEL     set default model (e.g. export ASK_MODEL=gemma3:4b)
  ASK_HOST      Ollama host (default: http://localhost:11434)

Examples:
  ask "what is a terraform workspace"
  cat error.log | ask "what is causing this error"
  git diff | ask "summarise these changes"
  ask -m gemma3:4b "fast local question"
  ask --plain "question" | pbcopy
EOF
    return 0
  fi

  # ── list models ───────────────────────────────────────────────────────────
  if [[ "$1" == "models" ]]; then
    curl -s "$ASK_HOST/api/tags" | python3 -c "
import sys, json
data = json.load(sys.stdin)
models = data.get('models', [])
if not models:
    print('No models found. Run: ollama pull llama3.2')
else:
    print('Available models:')
    for m in models:
        size_gb = m['size'] / 1e9
        print(f'  {m[\"name\"]:<30} {size_gb:.1f} GB')
" 2>/dev/null || echo "Ollama not running — start it with: ollama serve"
    return 0
  fi

  # ── flags ─────────────────────────────────────────────────────────────────
  local model="$ASK_MODEL"
  local plain=0

  while [[ "$1" == -* ]]; do
    case "$1" in
      -m)
        if [[ -z "$2" ]]; then
          echo "Error: -m requires a model name. Run 'ask models' to see options."
          return 1
        fi
        model="$2"; shift 2 ;;
      --plain)
        plain=1; shift ;;
      *)
        echo "Unknown option: $1. Run 'ask -h' for help."
        return 1 ;;
    esac
  done

  # ── check ollama is running ───────────────────────────────────────────────
  if ! curl -s --max-time 2 "$ASK_HOST/api/tags" &>/dev/null; then
    echo "Ollama is not running. Start it with: ollama serve"
    return 1
  fi

  # ── build prompt ──────────────────────────────────────────────────────────
  local prompt=""

  if [[ -p /dev/stdin ]]; then
    local piped_content
    piped_content=$(cat)
    if [[ -n "$1" ]]; then
      prompt="${1}"$'\n\n'"${piped_content}"
    else
      prompt="$piped_content"
    fi
  else
    if [[ -z "$1" ]]; then
      echo "Usage: ask \"your question\"  or  cat file | ask \"question\""
      echo "       ask -h for full help"
      return 1
    fi
    prompt="$1"
  fi

  # ── build payload ─────────────────────────────────────────────────────────
  local tmpfile outfile
  tmpfile=$(mktemp /tmp/ask_payload.XXXXXX)
  outfile=$(mktemp /tmp/ask_output.XXXXXX)

  python3 -c "
import json, sys
payload = {
    'model': sys.argv[1],
    'prompt': sys.argv[2],
    'stream': True
}
print(json.dumps(payload))
" "$model" "$prompt" > "$tmpfile"

  # ── spinner while waiting for response ───────────────────────────────────
  local spinner_frames=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')
  local spinner_i=0

  _ask_spinner() {
    while true; do
      printf "\r${spinner_frames[$spinner_i]} asking %s..." "$model" >&2
      spinner_i=$(( (spinner_i + 1) % ${#spinner_frames[@]} ))
      sleep 0.1
    done
  }

  _ask_spinner &
  local spinner_pid=$!
  trap "kill $spinner_pid 2>/dev/null; printf '\r\033[K' >&2" INT

  # ── collect full response ─────────────────────────────────────────────────
  curl -s "$ASK_HOST/api/generate" \
    -H "Content-Type: application/json" \
    -d "@$tmpfile" | python3 -c "
import sys, json
tokens = []
for line in sys.stdin:
    line = line.strip()
    if not line:
        continue
    try:
        data = json.loads(line)
        tokens.append(data.get('response', ''))
        if data.get('done'):
            break
    except json.JSONDecodeError:
        pass
with open(sys.argv[1], 'w') as f:
    f.write(''.join(tokens))
" "$outfile"

  # stop spinner and clear the line
  kill $spinner_pid 2>/dev/null
  wait $spinner_pid 2>/dev/null
  printf '\r\033[K' >&2
  trap - INT

  # ── render output ─────────────────────────────────────────────────────────
  if [[ $plain -eq 0 ]] && command -v bat &>/dev/null; then
    bat --language=markdown --style=plain "$outfile"
  else
    cat "$outfile"
  fi

  rm -f "$tmpfile" "$outfile"
}
